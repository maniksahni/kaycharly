// Kay Charly on Cloudflare: one Worker serves the site (repository root) and the API, with a D1 database,
// a KV namespace for menu photos and a 10-minute cron. Deployed automatically from GitHub (Workers Builds).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaycharly",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/rest/*", "/auth/*", "/functions/*", "/storage/*", "/worker/*", "/google-sheet/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kaycharly", "database_id": "e916b2b8-a11a-401c-afd0-a95d8300239d" }
  ],
  "kv_namespaces": [
    { "binding": "PHOTOS", "id": "6aa45850fb05427b928774cca32d1373" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://kaycharly.fr",
    "OWNER_EMAIL": "kaycharly91750@gmail.com",
    "SENDER_EMAIL": "kaycharly37@gmail.com"
  },
  // Keep variables added in the dashboard (deploys from GitHub must never remove them).
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
